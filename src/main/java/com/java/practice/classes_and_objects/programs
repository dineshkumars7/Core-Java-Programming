10. Object Return

java
class Product {
    int id;
    String name;
    double price;

    void showProduct() {
        System.out.println("Product ID: " + id + ", Name: " + name + ", Price: " + price);
    }
}

public class ObjectReturnDemo {
    // Method that creates, populates, and returns a Product object
    static Product createProduct(int id, String name, double price) {
        Product p = new Product();
        p.id = id;
        p.name = name;
        p.price = price;
        return p;
    }

    public static void main(String[] args) {
        Product item = createProduct(501, "Mechanical Keyboard", 3499.0);
        item.showProduct();
    }
}