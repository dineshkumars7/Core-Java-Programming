package pkg2;

import pkg1.ServiceProvider;

public class Program08_CrossPackageAccess {
    public static void main(String[] args) {
        ServiceProvider sp = new ServiceProvider();

        sp.publicMethod();       // Accessible everywhere

        // UNCOMMENTING ANY OF THESE WILL CAUSE COMPILE ERRORS:
        // sp.protectedMethod(); // Error: not a subclass in pkg2
        // sp.defaultMethod();   // Error: different package
        // sp.privateMethod();   // Error: private to ServiceProvider
    }
}